import yfinance as yf
import argparse
import json
from rich.console import Console

console = Console()

def fetch_prices(tickers):
    data = {}
    for ticker in tickers:
        try:
            stock = yf.Ticker(ticker)
            info = stock.info
            current_price = info.get('regularMarketPrice')
            if current_price:
                data[ticker] = current_price
            else:
                console.log(f"[yellow]Warning:[/yellow] Could not fetch current price for {ticker}")
        except Exception as e:
            console.log(f"[red]Error fetching price for {ticker}:[/red] {e}")
    return data

def main():
    parser = argparse.ArgumentParser(description="Fetch stock data using Yahoo Finance.")
    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # Price command
    price_parser = subparsers.add_parser("price", help="Fetch current stock prices.")
    price_parser.add_argument("--tickers", nargs="+", help="Space-separated list of ticker symbols.")

    args = parser.parse_args()

    if args.command == "price":
        if args.tickers:
            prices = fetch_prices(args.tickers)
            print(json.dumps(prices))
        else:
            console.log("[red]Error:[/red] Please provide ticker symbols for the 'price' command.")
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
